# Copy to .env, or run: python scripts/setup.py
#
# Two accounts are involved in DeFi Copilot, and only ONE needs a key here:
#
#   * The USER's wallet connects by QR and signs in HashPack. They never give
#     us a key, and nothing in the web UI asks for one.
#   * The AGENT's account signs autonomously with nobody present, so its key
#     must live on this machine. That is what this file holds.
#
# Nothing here is needed just to read balances or prices — the mirror node and
# SaucerSwap are both public and unauthenticated.

HEDERA_NETWORK=testnet

# The agent's own account, from https://portal.hedera.com
# IMPORTANT: create it with CREATE ECDSA ACCOUNT. The portal defaults to
# ED25519, which cannot sign the EVM transactions SaucerSwap's router needs.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_OPERATOR_EVM_ADDRESS=

# Created by scripts/bootstrap.py; leave blank.
HCS_AUDIT_TOPIC_ID=

# ---------------------------------------------------------------------------
# Everything below can be pasted into the running web page instead, with
# "remember" ticked. No need to edit this file for either.
# ---------------------------------------------------------------------------

# LLM for turning prompts into strategies. One is enough.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=

# WalletConnect, for the QR pairing. Free from https://cloud.reown.com
# Not a secret: it is shipped to every browser that loads the page.
WALLETCONNECT_PROJECT_ID=
