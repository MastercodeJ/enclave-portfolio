# ==========================================================================
# Local simulation environment
# ==========================================================================
# Copy to .env and edit. .env is gitignored -- the whole point of this project
# is that these values are private.

# Optional for local simulate; required only to deploy to the onchain registry.
CRE_ETH_PRIVATE_KEY=

# --- Mock service ---------------------------------------------------------
MOCK_PORT=8787
REBALANCER_PORTFOLIO_API_KEY=mock-portfolio-key

# ==========================================================================
# THE PORTFOLIO SPEC -- the entire strategy, as one secret
# ==========================================================================
# In production this lives in the Vault DON and is decrypted only inside the
# enclave. Everything about how the portfolio is constructed is in here:
#
#   universe     what it may hold
#   quote        the token buys are funded from / sells settle into
#   base         the strategic view, in bps (must sum to 10000)
#   signals      how the market tilts that view, and by how much (strength)
#   constraints  per-asset floors and ceilings, in bps
#   policy       when to act (drift_threshold), how much (max_trade),
#                and the worst execution tolerated (max_price_impact)
#
# Signal types: inverse_volatility, momentum, equal_weight.
# Strengths are shares of the final target and must not exceed 10000 in total;
# the remainder stays with the base view.
#
# Tokens below are the mock's testnet ids:
#   0.0.15058    WHBAR      0.0.5449   USDC      0.0.1183558  SAUCE
REBALANCER_PORTFOLIO_SPEC={"universe":["0.0.15058","0.0.5449","0.0.1183558"],"quote":"0.0.5449","base":{"0.0.15058":5000,"0.0.5449":3000,"0.0.1183558":2000},"signals":[{"type":"inverse_volatility","strength":6000,"lookback":20}],"constraints":{"min_weight":500,"max_weight":6000},"policy":{"drift_threshold":500,"max_trade":2000,"max_price_impact":100}}

# ==========================================================================
# LIQUIDATION PROTECTION POLICY -- secret, decrypted only inside the enclave
# ==========================================================================
#   floor_price        pre-emptive buffer survives down to this (vUSD/vETH x100)
#   hf_trigger         reactive layer acts when hf < this (x100)
#   hf_target          ...and restores to at least this
#   max_deposit_units  per intervention, vETH x100
#   max_repay_pct      per intervention, % of the ORIGINAL debt
#   cooldown_seconds   skip non-critical top-ups this soon after an action
# Choose your own values. Do NOT reuse anything that appears in this repo
# (this example, the tests, the README) -- those are public.
LIQUIDATION_POLICY={"floor_price":150000,"hf_trigger":103,"hf_target":110,"max_deposit_units":200,"max_repay_pct":10,"cooldown_seconds":600}
